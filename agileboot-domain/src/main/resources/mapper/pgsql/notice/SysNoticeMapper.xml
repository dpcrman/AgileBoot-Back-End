<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agileboot.domain.system.notice.db.SysNoticeMapper">

    <select id="getNoticeList" resultType="com.agileboot.domain.system.notice.db.SysNoticeEntity">
        SELECT n.*
        FROM sys_notice n
        LEFT JOIN sys_user u ON n.creator_id = u.user_id
        ${ew.customSqlSegment}
    </select>

</mapper>
